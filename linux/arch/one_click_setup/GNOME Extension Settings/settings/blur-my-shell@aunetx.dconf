[/]
settings-version=10

[appfolder]
pipeline='pipeline_default'

[applications]
blur=false
dynamic-opacity=false
opacity=215
pipeline='pipeline_default'
static-blur=true
whitelist=['org.gnome.clocks']

[coverflow-alt-tab]
pipeline='pipeline_default'

[dash-to-dock]
blur=false
pipeline='pipeline_default'

[lockscreen]
pipeline='pipeline_default'

[overview]
pipeline='pipeline_default'

[panel]
blur=false
pipeline='pipeline_default'

[popup]
pipeline='pipeline_default'
preserve-shell-theme=false
screenshot-corner-radius=36
static-blur=true
style-popup=3

[screenshot]
pipeline='pipeline_default'

[window-list]
pipeline='pipeline_default'
